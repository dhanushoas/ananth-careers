# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:4200
# Comma-separated allow-list of browser origins
CORS_ORIGINS=http://localhost:4200
# Number of reverse proxies in front of the API (1 behind Nginx)
TRUST_PROXY=0
LOG_LEVEL=info

# ── Database (MongoDB Atlas in production) ────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ananth?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# COOKIE_SECURE defaults to true in production
# COOKIE_SECURE=true
# Google sign-in: OAuth 2.0 Web client ID (public value) from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=

# ── File encryption & storage ─────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FILE_ENCRYPTION_KEY=
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# For STORAGE_DRIVER=s3 (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Email (required in production) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Veejee Services <no-reply@your-domain.in>

# ── Rate limits ───────────────────────────────────────────
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30
CONTACT_RATE_LIMIT_MAX=5

# ── First administrator (npm run seed) ────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=ANANTH Administrator
SEED_ADMIN_MOBILE=
